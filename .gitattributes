# Auto detect text files and perform LF normalization
* text=auto

# Go source files
*.go text diff=golang

# Markdown files
*.md text

# YAML files
*.yaml text
*.yml text

# JSON files
*.json text

# Shell scripts
*.sh text eol=lf

# Batch files
*.bat text eol=crlf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.tar.gz binary
*.zip binary
