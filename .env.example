# BingDork Pro Environment Variables
# Copy this to .env and modify as needed

# Logging
BINGDORK_LOGGING_LEVEL=info
BINGDORK_LOGGING_FORMAT=console

# Network
BINGDORK_NETWORK_TIMEOUT=30s
BINGDORK_NETWORK_RETRY_COUNT=3
BINGDORK_NETWORK_RATE_LIMIT=10
BINGDORK_NETWORK_HTTP2=true
BINGDORK_NETWORK_COMPRESS=true

# Proxy (optional)
# BINGDORK_NETWORK_PROXY=socks5://127.0.0.1:9050
# BINGDORK_NETWORK_PROXY_TYPE=socks5

# CAPTCHA Bypass (optional)
# BINGDORK_NETWORK_CAPTCHA_ENABLED=true
# BINGDORK_NETWORK_CAPTCHA_SERVICE=2captcha
# BINGDORK_NETWORK_CAPTCHA_API_KEY=your_api_key_here

# Anti-bot Evasion
BINGDORK_NETWORK_EVASION_ENABLED=true
BINGDORK_NETWORK_EVASION_FINGERPRINT_RANDOMIZE=true
BINGDORK_NETWORK_EVASION_HEADER_SPOOFING=true
BINGDORK_NETWORK_EVASION_BEHAVIOR_MIMIC=true
BINGDORK_NETWORK_EVASION_TLS_FINGERPRINT=true
BINGDORK_NETWORK_EVASION_RANDOM_DELAY_MIN=1s
BINGDORK_NETWORK_EVASION_RANDOM_DELAY_MAX=3s

# Providers
BINGDORK_PROVIDERS_DEFAULT=bing
BINGDORK_PROVIDERS_BING_ENABLED=true
BINGDORK_PROVIDERS_BING_RATE_LIMIT=10

# Cache
BINGDORK_CACHE_ENABLED=true
BINGDORK_CACHE_TYPE=memory
BINGDORK_CACHE_TTL=5m

# Storage
BINGDORK_STORAGE_TYPE=sqlite

# Output
BINGDORK_OUTPUT_FORMAT=json
BINGDORK_OUTPUT_PRETTY_PRINT=true

# Scheduler
BINGDORK_SCHEDULER_WORKERS=5
BINGDORK_SCHEDULER_RATE_LIMIT=10
BINGDORK_SCHEDULER_RESUME=true
